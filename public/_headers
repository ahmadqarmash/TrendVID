# Static asset headers (Workers static assets read this file). HTML headers are set in src/worker.js.
/assets/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=3600

/assets/img/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/ads.txt
  Cache-Control: public, max-age=3600

# Fonts never change in place (a new font gets a new file name), so cache them for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
