# TrendVid headers (Cloudflare Pages: site/_headers)
# NOTE: keep every third-party host used for revenue in the CSP, or ads/analytics break silently.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), fullscreen=(self https://www.youtube.com)
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate

# --- Content-Security-Policy -------------------------------------------------
# Shipped in REPORT-ONLY mode on purpose: verify in the browser console (and in the
# CSP reports) that AdSense, GA4 and the YouTube player all still work, then switch
# to the enforcing header below (see docs/RUNBOOK.md "Enable the CSP").
Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://partner.googleadservices.com https://tpc.googlesyndication.com https://www.googletagmanager.com https://static.cloudflareinsights.com https://adservice.google.com https://www.google.com https://www.gstatic.com https://fundingchoicesmessages.google.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https://api.trendvid.net https://www.google-analytics.com https://region1.google-analytics.com https://pagead2.googlesyndication.com https://ep1.adtrafficquality.google https://www.cloudflare.com https://cloudflareinsights.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://fundingchoicesmessages.google.com; form-action 'self'; upgrade-insecure-requests

# When verified, delete the line above and use this (same value, enforcing):
# Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://partner.googleadservices.com https://tpc.googlesyndication.com https://www.googletagmanager.com https://static.cloudflareinsights.com https://adservice.google.com https://www.google.com https://www.gstatic.com https://fundingchoicesmessages.google.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https://api.trendvid.net https://www.google-analytics.com https://region1.google-analytics.com https://pagead2.googlesyndication.com https://ep1.adtrafficquality.google https://www.cloudflare.com https://cloudflareinsights.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://fundingchoicesmessages.google.com; form-action 'self'; upgrade-insecure-requests

# --- caching -----------------------------------------------------------------
# We do NOT content-hash filenames yet, so app code/CSS must revalidate often:
# immutable caching here would strand returning visitors on an old build.

/assets/js/*
  Cache-Control: public, max-age=300, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=300, must-revalidate

/assets/og.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

# --- preview safety ----------------------------------------------------------
# Pages preview URLs (*.pages.dev) are NOT covered here. Add a Cloudflare
# Configuration Rule for the preview hostname that sets:
#   X-Robots-Tag: noindex
# so Google never indexes a duplicate staging copy (see docs/DEPLOYMENT.md).
